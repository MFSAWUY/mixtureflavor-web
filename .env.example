# Use python scripts/init_env.py to create .env with a generated password.
# Local Docker defaults:
SITE_ADDRESS=:80
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
FLAVOR_ADMIN_USER=admin
FLAVOR_ADMIN_PASSWORD=
FLAVOR_DATABASE=/data/submissions.sqlite3
# Production: SITE_ADDRESS=your-domain.com, BIND_ADDRESS=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443
